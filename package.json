{
  "name": "agent-ohada",
  "productName": "Agent OHADA (Le-DAF)",
  "description": "Agent OHADA (Le-DAF) — Pilotage Financier & Comptabilité OHADA",
  "version": "2.0.2",
  "author": "Agent OHADA",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "build:electron": "vite build && node build-installer.cjs",
    "dist:exe": "vite build && node build-installer.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "34.0.0",
    "electron-builder": "^26.15.3",
    "innosetup": "^6.4.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.agentohada.app",
    "productName": "Agent OHADA (Le-DAF)",
    "electronVersion": "34.0.0",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/*.sqlite*",
      "!server/*.backup*",
      "!server/node_modules/**/*",
      "!server/*.log",
      "!server/test_*.js",
      "!server/scripts/**/*",
      "!server/*.pdf",
      "!server/*.xlsx"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent OHADA (Le-DAF)",
      "artifactName": "AgentOHADA-Setup-v${version}.${ext}"
    }
  }
}
